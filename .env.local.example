# LLM(自然文の属性抽出・マイタイムライン)は Vertex AI Gemini を使用（IAM認証・APIキー不要）
# ローカルで使う場合: `gcloud auth application-default login` でADCを用意し、下記を設定
#   （未設定なら語句一致のルールベースで動作）
GOOGLE_CLOUD_PROJECT=
# Vertex のロケーション（未設定時は global）
GCP_LOCATION=global

# ジオコーディング(Nominatim)に付与する連絡先メール（任意・利用ポリシー対応）
NOMINATIM_CONTACT_EMAIL=
